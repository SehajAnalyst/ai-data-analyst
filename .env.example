# .env.example — copy to .env and fill in your values.
# .env is in .gitignore and must never be committed.

# ── LLM provider ────────────────────────────────────────────────────
# Groq is the only working provider in V1.
DEFAULT_LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_key_here

# Optional per-request overrides for Groq:
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_TEMPERATURE=0.0
# GROQ_MAX_TOKENS=2048
# GROQ_TIMEOUT_SECONDS=20

# ── Database ─────────────────────────────────────────────────────────
# The database to query. SQLite only in V1.
DATABASE_URL=sqlite:///./data/sample.db
DB_DIALECT=sqlite

# ── Safety ───────────────────────────────────────────────────────────
MAX_QUERY_ROWS=1000
DB_QUERY_TIMEOUT_SECONDS=15

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Use "console" for local dev, "json" in production.
LOG_FORMAT=console
